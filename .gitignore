# Dependências
node_modules/

# Artefatos de build web (gerados por npm run build:web)
www/app.js
www/app.js.map

# Artefatos de build Android (gerados por npm run build:apk / build:aab).
# Ficavam versionados e envelheciam: quem clonasse o repo instalaria um APK
# com o código de meses atrás achando que era a versão atual.
*.apk
*.aab

# Segredos — NUNCA versionar
*.keystore
*.jks
keystore.properties

# Onde ficam os backups da chave. Não é segredo em si, mas o repo é público e
# isto é um mapa de onde pegar a chave. O checklist versionado só diz "nuvem +
# dois volumes locais".
store/backup-local.md

# SO / editores
.DS_Store
Thumbs.db
.vscode/
.idea/
